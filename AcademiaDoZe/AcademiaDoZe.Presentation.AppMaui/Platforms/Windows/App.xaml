<maui:MauiWinUIApplication
    x:Class="AcademiaDoZe.Presentation.AppMaui.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:AcademiaDoZe.Presentation.AppMaui.WinUI">

    <!-- Substitui a cor de destaque do Windows (indicador do menu, foco dos campos etc.)
         pela paleta azul da aplicação, independentemente da cor escolhida no sistema -->
    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColorDark3">#172554</Color>
            <Color x:Key="SystemAccentColorDark2">#1E3A8A</Color>
            <Color x:Key="SystemAccentColorDark1">#1E40AF</Color>
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>

            <!-- Itens do menu lateral (NavigationView): seleção em pílula azul ocupando a largura toda.
                 O menu tem fundo escuro nos dois temas, por isso os mesmos pincéis valem para claro e escuro. -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#111C33"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#162544"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1E40AF"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1E3A8A"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#93C5FD"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B1220"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B1220"/>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#111C33"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#162544"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1E40AF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1E3A8A"/>
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#93C5FD"/>
                    <!-- Campos (Entry, Picker, DatePicker): o controle nativo fica transparente e sem borda,
                         para que só o contorno arredondado do CampoBorda apareça -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent"/>
                    <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                    <SolidColorBrush x:Key="CalendarDatePickerBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushDisabled" Color="Transparent"/>
                    <Thickness x:Key="CalendarDatePickerBorderThemeThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#111C33"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#162544"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1E40AF"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1E3A8A"/>
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#93C5FD"/>
                    <!-- Campos (Entry, Picker, DatePicker): o controle nativo fica transparente e sem borda,
                         para que só o contorno arredondado do CampoBorda apareça -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent"/>
                    <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                    <SolidColorBrush x:Key="CalendarDatePickerBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundFocused" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="CalendarDatePickerBorderBrushDisabled" Color="Transparent"/>
                    <Thickness x:Key="CalendarDatePickerBorderThemeThickness">0</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
