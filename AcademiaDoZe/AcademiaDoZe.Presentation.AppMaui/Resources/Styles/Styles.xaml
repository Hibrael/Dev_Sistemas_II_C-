    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FundoClaro}, Dark={StaticResource FundoEscuro}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CampoEscuro}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{StaticResource MenuFundo}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>


    <!-- ===== Estilos personalizados da Academia do Zé ===== -->

    <!-- Cartões -->
    <Style TargetType="Border" x:Key="CardBorder">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardClaro}, Dark={StaticResource CardEscuro}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaClaro}, Dark={StaticResource BordaEscuro}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <!-- Selo do CEP na lista -->
    <Style TargetType="Border" x:Key="Badge">
        <Setter Property="BackgroundColor" Value="#1F3B82F6"/>
        <Setter Property="Stroke" Value="#4D3B82F6"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <!-- Tiles de seleção (tema) e segmentos (tipo de banco) -->
    <Style TargetType="Border" x:Key="TileSelecao">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaClaro}, Dark={StaticResource BordaEscuro}}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="Border" x:Key="CampoBorda">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CampoClaro}, Dark={StaticResource CampoEscuro}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordaClaro}, Dark={StaticResource BordaEscuro}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <!-- Textos -->
    <Style TargetType="Label" x:Key="TextoSecundario">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecClaro}, Dark={StaticResource TextoSecEscuro}}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Label" x:Key="RotuloMaiusculo">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecClaro}, Dark={StaticResource TextoSecEscuro}}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="1.5"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
    </Style>
    <Style TargetType="Label" x:Key="NumeroGrande">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}"/>
    </Style>
    <Style TargetType="Label" x:Key="TituloCard">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Label" x:Key="Icone">
        <Setter Property="FontFamily" Value="MaterialIcons"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextColor" Value="{StaticResource AzulClaro}"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

    <!-- Botões -->
    <Style TargetType="Button" x:Key="ButtonPrimary">
        <Setter Property="BackgroundColor" Value="{StaticResource AzulEscuro}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>
    <Style TargetType="Button" x:Key="ButtonSecondary">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BordaClaro}, Dark={StaticResource BordaEscuro}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>
    <!-- Segmentos (tipo de banco): estado desligado; o ligado usa ButtonPrimary -->
    <Style TargetType="Button" x:Key="ButtonSegmento">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecClaro}, Dark={StaticResource TextoSecEscuro}}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="HeightRequest" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>
    <!-- Ações da lista: dois botões preenchidos em formato de pílula -->
    <Style TargetType="Button" x:Key="ButtonSmall">
        <Setter Property="BackgroundColor" Value="{StaticResource AzulEscuro}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="HeightRequest" Value="34"/>
        <Setter Property="WidthRequest" Value="52"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="Button" x:Key="ButtonDanger">
        <Setter Property="BackgroundColor" Value="{StaticResource AzulClaro}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="HeightRequest" Value="34"/>
        <Setter Property="WidthRequest" Value="52"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
</ResourceDictionary>
