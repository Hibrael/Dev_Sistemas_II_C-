<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:behaviors="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Behaviors"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <StackLayout Spacing="20">

            <!-- CEP Section -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="5">
                    <Label Text="CEP"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding Logradouro.Cep}" Placeholder="00000-000" Keyboard="Numeric" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Text="Buscar CEP" Command="{Binding SearchByCepCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="40" Padding="15,0">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="{StaticResource White}"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </StackLayout>
            </Border>

            <!-- Dados do Logradouro -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="15">
                    <Label Text="{Binding Logradouro.Id, StringFormat='Logradouro ID: {0}'}" Style="{StaticResource SubHeadline}"/>

                    <!-- Nome -->
                    <StackLayout Spacing="5">
                        <Label Text="Nome/Rua"/>
                        <Entry Text="{Binding Logradouro.Nome}" Placeholder="Digite o nome da rua..."/>
                    </StackLayout>

                    <!-- Bairro -->
                    <StackLayout Spacing="5">
                        <Label Text="Bairro"/>
                        <Entry Text="{Binding Logradouro.Bairro}" Placeholder="Digite o bairro..."/>
                    </StackLayout>

                    <!-- País → Estado → Cidade: escolhidos em listas (sem digitação livre) -->
                    <StackLayout Spacing="5">
                        <Label Text="País"/>
                        <Picker ItemsSource="{Binding Paises}" SelectedItem="{Binding PaisSelecionado}"/>
                    </StackLayout>

                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                        <!-- Estado -->
                        <StackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Estado"/>
                            <!-- Brasil: lista de UFs -->
                            <Picker ItemsSource="{Binding Ufs}" SelectedItem="{Binding EstadoSelecionado}" IsVisible="{Binding IsBrasil}"/>
                            <!-- Outros países: sigla de 2 letras, só letras -->
                            <Entry Text="{Binding Logradouro.Estado}" Placeholder="Sigla" MaxLength="2" TextTransform="Uppercase" IsVisible="{Binding IsOutroPais}">
                                <Entry.Behaviors>
                                    <behaviors:ApenasLetrasBehavior/>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>

                        <!-- Cidade -->
                        <StackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Cidade"/>
                            <!-- Brasil: municípios da UF escolhida (IBGE) -->
                            <Picker ItemsSource="{Binding Cidades}" SelectedItem="{Binding CidadeSelecionada}" IsVisible="{Binding IsBrasil}"/>
                            <!-- Outros países: só letras, espaço, hífen e apóstrofo -->
                            <Entry Text="{Binding Logradouro.Cidade}" Placeholder="Digite a cidade..." MaxLength="100" IsVisible="{Binding IsOutroPais}">
                                <Entry.Behaviors>
                                    <behaviors:ApenasLetrasBehavior PermitirEspacos="True"/>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </Border>

            <!-- Botões de Ação -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="15,10">
                <Button Grid.Column="0" Text="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource ButtonSecondary}" HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5c9;" Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                    </Button.ImageSource>
                </Button>
                <Button Grid.Column="1" Text="Salvar" Command="{Binding SaveLogradouroCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="50">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Color="{StaticResource White}"/>
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>

        </StackLayout>
    </ScrollView>
</ContentPage>
