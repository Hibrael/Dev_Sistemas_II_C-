<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:behaviors="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Behaviors"
             x:DataType="vm:DashboardListViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="20">

            <!-- Cabeçalho compacto: logo + rótulo + data -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="18">
                <Image Grid.Column="0" WidthRequest="130" HeightRequest="93" Aspect="AspectFit" VerticalOptions="Center">
                    <Image.Source>
                        <AppThemeBinding Light="academiadoze_claro.png" Dark="academiadoze_escuro.png"/>
                    </Image.Source>
                </Image>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="Painel de gestão" Style="{StaticResource RotuloMaiusculo}" TextColor="{StaticResource AzulClaro}" CharacterSpacing="3"/>
                    <Label Text="{Binding DataHoje}" FontFamily="OpenSansSemibold" FontSize="22"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Mosaico de indicadores -->
            <Grid Grid.Row="1" ColumnDefinitions="1.3*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">

                <!-- Destaque: Alunos -->
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource HeroInicio}" Offset="0.0"/>
                            <GradientStop Color="{StaticResource HeroFim}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="&#xe80c;" FontFamily="MaterialIcons" FontSize="190" TextColor="White" Opacity="0.08"
                               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-24,-40"/>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe80c;" Style="{StaticResource Icone}" TextColor="White" FontSize="18"/>
                                <Label Text="Alunos" Style="{StaticResource RotuloMaiusculo}" TextColor="#BFDBFE"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalAlunos}" Style="{StaticResource NumeroGrande}" FontSize="68" TextColor="White"/>
                            <Label Text="{Binding AlunosComMatriculaAtiva, StringFormat='{0} com matrícula ativa'}" FontSize="13" TextColor="#BFDBFE"/>
                            <ProgressBar Progress="{Binding PercentualAlunosMatriculados}" ProgressColor="#93C5FD" Margin="0,14,0,0"/>
                            <Label Text="{Binding PercentualAlunosMatriculados, StringFormat='{0:P0} dos alunos matriculados'}" FontSize="13" TextColor="#BFDBFE"/>
                            <HorizontalStackLayout Spacing="4" Margin="0,24,0,0">
                                <Label Text="Ver alunos" FontFamily="OpenSansSemibold" FontSize="13" TextColor="White"/>
                                <Label Text="&#xe5c8;" Style="{StaticResource Icone}" TextColor="White" FontSize="16"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Logradouros -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <Border.Behaviors>
                        <behaviors:CardHoverBehavior/>
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="&#xe7f1;" FontFamily="MaterialIcons" FontSize="120" TextColor="{StaticResource AzulClaro}" Opacity="0.09"
                               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-14,-26"/>
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe7f1;" Style="{StaticResource Icone}" FontSize="18"/>
                                <Label Text="Logradouros" Style="{StaticResource RotuloMaiusculo}"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalLogradouros}" Style="{StaticResource NumeroGrande}"/>
                            <Label Text="endereços cadastrados" Style="{StaticResource TextoSecundario}"/>
                            <HorizontalStackLayout Spacing="4" Margin="0,14,0,0">
                                <Label Text="Abrir" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource AzulClaro}"/>
                                <Label Text="&#xe5c8;" Style="{StaticResource Icone}" FontSize="16"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Colaboradores -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Border.Behaviors>
                        <behaviors:CardHoverBehavior/>
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="&#xea67;" FontFamily="MaterialIcons" FontSize="120" TextColor="{StaticResource AzulClaro}" Opacity="0.09"
                               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-14,-26"/>
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xea67;" Style="{StaticResource Icone}" FontSize="18"/>
                                <Label Text="Colaboradores" Style="{StaticResource RotuloMaiusculo}"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalColaboradores}" Style="{StaticResource NumeroGrande}"/>
                            <Label Text="na equipe" Style="{StaticResource TextoSecundario}"/>
                            <HorizontalStackLayout Spacing="4" Margin="0,14,0,0">
                                <Label Text="Abrir" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource AzulClaro}"/>
                                <Label Text="&#xe5c8;" Style="{StaticResource Icone}" FontSize="16"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Matrículas (largo) -->
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}">
                    <Border.Behaviors>
                        <behaviors:CardHoverBehavior/>
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="&#xefec;" FontFamily="MaterialIcons" FontSize="120" TextColor="{StaticResource AzulClaro}" Opacity="0.09"
                               HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-14,-26"/>
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xefec;" Style="{StaticResource Icone}" FontSize="18"/>
                                <Label Text="Matrículas" Style="{StaticResource RotuloMaiusculo}"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding TotalMatriculas}" Style="{StaticResource NumeroGrande}"/>
                            <Label Text="{Binding MatriculasAtivas, StringFormat='{0} ativas no momento'}" Style="{StaticResource TextoSecundario}"/>
                            <ProgressBar Progress="{Binding PercentualMatriculasAtivas}" ProgressColor="{StaticResource AzulClaro}" Margin="0,12,120,0"/>
                            <HorizontalStackLayout Spacing="4" Margin="0,14,0,0">
                                <Label Text="Abrir" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource AzulClaro}"/>
                                <Label Text="&#xe5c8;" Style="{StaticResource Icone}" FontSize="16"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>

        </Grid>
    </ScrollView>
</ContentPage>
