<?xml version="1.0" encoding="utf-8" ?>
<!-- Hibrael Andre Cidade Xavier -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:MatriculaListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             Title="{Binding Title}">

    <!-- Recursos locais da página: converters e o template de uma matrícula, usado pelo CollectionView.
         EnumDisplay mostra o [Display] do plano e RestricoesDisplay junta as restrições marcadas do enum [Flags].
         OnIdiom ajusta o tamanho da foto conforme o dispositivo: Phone, Tablet, Desktop, TV e Default. -->
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter"/>
        <converters:EnumDisplayConverter x:Key="EnumDisplay"/>
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay"/>
        <converters:MascaraConverter x:Key="Mascara"/>

        <DataTemplate x:Key="MatriculaItemTemplate" x:DataType="dto:MatriculaDto">
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" RowSpacing="12">

                    <!-- Miniatura da foto do aluno (ícone de pessoa aparece por trás enquanto não há imagem) -->
                    <Border Grid.Row="0" Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CampoClaro}, Dark={StaticResource CampoEscuro}}">
                        <Border.WidthRequest>
                            <OnIdiom x:TypeArguments="x:Double">
                                <OnIdiom.Phone>64</OnIdiom.Phone>
                                <OnIdiom.Tablet>76</OnIdiom.Tablet>
                                <OnIdiom.Desktop>76</OnIdiom.Desktop>
                                <OnIdiom.TV>100</OnIdiom.TV>
                                <OnIdiom.Default>64</OnIdiom.Default>
                            </OnIdiom>
                        </Border.WidthRequest>
                        <Border.HeightRequest>
                            <OnIdiom x:TypeArguments="x:Double">
                                <OnIdiom.Phone>64</OnIdiom.Phone>
                                <OnIdiom.Tablet>76</OnIdiom.Tablet>
                                <OnIdiom.Desktop>76</OnIdiom.Desktop>
                                <OnIdiom.TV>100</OnIdiom.TV>
                                <OnIdiom.Default>64</OnIdiom.Default>
                            </OnIdiom>
                        </Border.HeightRequest>
                        <Grid>
                            <Label Text="&#xe7fd;" Style="{StaticResource Icone}" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill"/>
                        </Grid>
                    </Border>

                    <!-- Nome do aluno e selos: número da matrícula e plano -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="6">
                        <Label Text="{Binding AlunoMatricula.Nome}" Style="{StaticResource TituloCard}" LineBreakMode="TailTruncation"/>
                        <HorizontalStackLayout Spacing="6">
                            <Border Style="{StaticResource Badge}">
                                <Label Text="{Binding Id, StringFormat='#{0}'}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource AzulClaro}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" BackgroundColor="{StaticResource AzulEscuro}" Stroke="{StaticResource AzulEscuro}">
                                <Label Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource White}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Botões de Ação -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="8" VerticalOptions="Start">
                        <Button Style="{StaticResource ButtonSmall}" Clicked="OnEditButtonClicked" ToolTipProperties.Text="Editar">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Color="{StaticResource White}"/>
                            </Button.ImageSource>
                        </Button>
                        <Button Style="{StaticResource ButtonDanger}" Clicked="OnDeleteButtonClicked" ToolTipProperties.Text="Excluir">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Color="{StaticResource White}"/>
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>

                    <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BordaClaro}, Dark={StaticResource BordaEscuro}}"/>

                    <!-- Dados: ícone + valor -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="22,*" ColumnSpacing="8" RowSpacing="6"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- CPF e nascimento do aluno -->
                        <Label Grid.Row="0" Text="&#xe90d;" Style="{StaticResource Icone}" FontSize="16"/>
                        <Label Grid.Row="0" Grid.Column="1" FontSize="13" LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding AlunoMatricula.Cpf, Converter={StaticResource Mascara}, ConverterParameter=Cpf, StringFormat='CPF {0}'}"/>
                                    <Span Text=" · "/>
                                    <Span Text="{Binding AlunoMatricula.DataNascimento, StringFormat='Nascimento {0:dd/MM/yyyy}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Vigência: início e data final calculada pelo plano -->
                        <Label Grid.Row="1" Text="&#xe878;" Style="{StaticResource Icone}" FontSize="16"/>
                        <Label Grid.Row="1" Grid.Column="1" FontSize="13">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Vigência " FontFamily="OpenSansSemibold"/>
                                    <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"/>
                                    <Span Text=" até "/>
                                    <Span Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Objetivo -->
                        <Label Grid.Row="2" Text="&#xe153;" Style="{StaticResource Icone}" FontSize="16" VerticalOptions="Start"/>
                        <Label Grid.Row="2" Grid.Column="1" FontSize="13" LineBreakMode="WordWrap" MaxLines="2">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Objetivo " FontFamily="OpenSansSemibold"/>
                                    <Span Text="{Binding Objetivo}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Restrições médicas (enum [Flags]: todas as marcadas) -->
                        <Label Grid.Row="3" Text="&#xe548;" Style="{StaticResource Icone}" FontSize="16" VerticalOptions="Start"/>
                        <Label Grid.Row="3" Grid.Column="1" FontSize="13" LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Restrições " FontFamily="OpenSansSemibold"/>
                                    <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Observações sobre as restrições (só quando preenchidas) -->
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding ObservacoesRestricoes, StringFormat='Obs.: {0}'}" Style="{StaticResource TextoSecundario}" FontSize="12" LineBreakMode="WordWrap" MaxLines="2">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ObservacoesRestricoes}" Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ObservacoesRestricoes}" Value="">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- Selo de laudo médico anexado (some quando não há laudo) -->
                        <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource Badge}" BackgroundColor="#1F22C55E" Stroke="#6622C55E">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding LaudoMedico}" Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="&#xe86c;" Style="{StaticResource Icone}" FontSize="13" TextColor="{StaticResource Sucesso}"/>
                                <Label Text="Laudo médico anexado" FontFamily="OpenSansSemibold" FontSize="11" TextColor="{StaticResource Sucesso}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- estrutura principal da página -->
    <Grid RowDefinitions="Auto,Auto,*" Padding="24,18,24,12" RowSpacing="14">

        <!-- Cabeçalho: total + atualizar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="{Binding Matriculas.Count, StringFormat='{0} matrícula(s) na lista'}" Style="{StaticResource TextoSecundario}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource ButtonSecondary}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d5;" Color="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoEscuro}}"/>
                </Button.ImageSource>
            </Button>
        </Grid>

        <!-- Busca: filtro (lista suspensa) na primeira linha; valor + buscar na segunda.
             Em duas linhas porque o filtro mais longo ("Vencendo em dias") não deixaria espaço para o campo no celular -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="10" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="10">
                    <Label Text="Filtrar por" Style="{StaticResource RotuloMaiusculo}" FontSize="11" VerticalOptions="Center"/>
                    <Border Style="{StaticResource CampoBorda}" Padding="6,0">
                        <Picker Title="" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" WidthRequest="160" VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CampoBorda}" Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="&#xe8b6;" Style="{StaticResource Icone}" TextColor="{AppThemeBinding Light={StaticResource TextoSecClaro}, Dark={StaticResource TextoSecEscuro}}"/>
                        <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="{Binding SearchPlaceholder}" VerticalOptions="Center" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchMatriculasCommand}"/>
                    </Grid>
                </Border>
                <Button Grid.Row="1" Grid.Column="1" Text="Buscar" Command="{Binding SearchMatriculasCommand}" Style="{StaticResource ButtonPrimary}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="{StaticResource White}"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- lista/grade + FAB -->
        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Matriculas}" SelectionMode="None" ItemTemplate="{StaticResource MatriculaItemTemplate}">

                    <!-- Span conforme OnIdiom: lista no celular, grade nos demais -->
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" HorizontalItemSpacing="14" VerticalItemSpacing="14">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="20">
                            <Label Text="&#xefec;" Style="{StaticResource Icone}" FontSize="56" HorizontalOptions="Center" Opacity="0.5"/>
                            <Label Text="Nenhuma matrícula encontrada" Style="{StaticResource SubHeadline}" FontSize="20"/>
                            <Button Text="Adicionar Primeira Matrícula" Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonPrimary}" HorizontalOptions="Center">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Color="{StaticResource White}"/>
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <!-- FAB: nova matrícula -->
            <Button Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonPrimary}" CornerRadius="28" WidthRequest="56" HeightRequest="56" Padding="0"
                    HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,8" ToolTipProperties.Text="Nova matrícula">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource AzulEscuro}" Offset="0,6" Radius="14" Opacity="0.45"/>
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Size="24" Color="{StaticResource White}"/>
                </Button.ImageSource>
            </Button>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
